# Names only. Put real values in Railway service variables (or a local .env, which is git-ignored).
MONGODB_URI=            # MongoDB Atlas connection string; leave empty to run stateless
ALLOWED_ORIGINS=        # comma-separated frontend URLs, e.g. https://secundo.up.railway.app
MAX_UPLOAD_BYTES=15728640
OMR_MODEL_PATH=runs/seven_notes/best.keras
OMR_LABELS_PATH=runs/seven_notes/labels.json
# Frontend (build-time, web service): VITE_API_URL=https://<api-service>.up.railway.app  VITE_BASE=/
